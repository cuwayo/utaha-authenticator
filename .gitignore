# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Release signing. The real file and the keystore must never be committed.
# android/.gitignore already covers these; repeated here so a root-level
# `git add -A` cannot catch them.
/android/key.properties
**/*.jks
**/*.keystore

# Obfuscation symbols from `flutter build --split-debug-info`.
# Needed to read crash reports, but they are build output, not source.
/build/symbols/
app.*.symbols
app.*.map.json

# Generated code.
#
# build_runner and gen-l10n output is derived from source, so it is not
# committed: a committed copy can silently drift from the source it was
# generated from, and the drift shows up as confusing compile errors rather
# than as a missing regeneration step.
#
# Both are regenerated by CI before analyze and test. Locally:
#
#   flutter pub get        # also runs gen-l10n, because pubspec sets generate: true
#   dart run build_runner build
#
*.g.dart
*.freezed.dart
lib/l10n/app_localizations*.dart
